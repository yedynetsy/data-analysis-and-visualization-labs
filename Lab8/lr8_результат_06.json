 "код_студента": {
  "tournament": "def tournament(F, k, rng):\n    candidates = rng.integers(0, len(F), size=k)\n    return int(candidates[np.argmin(F[candidates])])\n",
  "ox": "def ox(p1, p2, i, j):\n    child = np.empty_like(p1)\n    child[i:j + 1] = p1[i:j + 1]\n    used = set(p1[i:j + 1])\n    pos = (j + 1) % len(p1)\n    for step in range(len(p2)):\n        gene = p2[(j + 1 + step) % len(p2)]\n        if gene not in used:\n            child[pos] = gene\n            pos = (pos + 1) % len(p1)\n    return child\n",
  "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    # Ваги лише для невідвіданих точок, з урахуванням обох показників.\n    weights = tau[cur, left] ** alpha * eta[cur, left] ** beta\n    cumulative = np.cumsum(weights)\n    total = cumulative[-1]\n    if total <= 0 or not np.isfinite(total):\n        # Резервний рівномірний вибір, якщо всі ваги нульові.\n        return int(rng.choice(left))\n    # Вибір за накопиченими вагами еквівалентний нормуванню і rng.choice.\n    index = np.searchsorted(cumulative, rng.random() * total, side='right')\n    return int(left[min(index, len(left) - 1)])\n",
  "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    new_tau = (1.0 - rho) * np.asarray(tau, dtype=float)\n    for tour, length in zip(tours, lens):\n        route = np.concatenate(([0], tour, [0])).astype(int)\n        np.add.at(new_tau, (route[:-1], route[1:]), 1.0 / length)\n    return new_tau\n"
 },
